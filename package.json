{
  "name": "@lumine-code/tree-sitter-latex",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "A Tree-sitter grammar for LaTeX documents.",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check --end-of-line auto eslint.config.js \"test/*.cjs\" package.json .prettierrc .github/workflows/ci.yml",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "build:wasm": "tree-sitter build --wasm",
    "test:wasm": "npm run build:wasm && node --liftoff-only --test test/wasm_test.cjs",
    "test:update": "tree-sitter test --update",
    "install": "node-gyp-build"
  },
  "repository": "https://github.com/lumine-code/tree-sitter-latex",
  "keywords": [
    "tree-sitter",
    "latex",
    "parser"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "test",
    "tree-sitter.json",
    "*.wasm",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/lumine-code/tree-sitter-latex/issues"
  },
  "homepage": "https://github.com/lumine-code/tree-sitter-latex",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0 || ^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tree-sitter-cli": "0.27.1",
    "web-tree-sitter": "0.27.1"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true
  },
  "tree-sitter": [
    {
      "scope": "source.tex",
      "file-types": [
        "tex",
        "sty",
        "cls",
        "aux"
      ]
    }
  ]
}
